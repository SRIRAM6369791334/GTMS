# ==============================================================================
# GTMS Production Synology NAS Docker Environment Configuration Template
# Copy this file to .env on your Synology NAS in your compose directory.
# NEVER commit the filled .env file with production secrets to version control!
# ==============================================================================

# Application Image & Container Settings
# Set GTMS_IMAGE_TAG to a specific Git commit SHA for immutable deployments
# (e.g. GTMS_IMAGE_TAG=d85db024765d70234a9b...) or use 'main'
GTMS_IMAGE_TAG=main

# Persistent Storage Root on Synology NAS
# Ensure this volume exists in DSM Storage Manager (e.g., /volume1/docker/gtms-data)
GTMS_DATA_DIR=/volume1/docker/gtms-data

# Host Port for Web Access
APP_PORT=8000

# Application Configuration
APP_NAME=GTMS
APP_ENV=production
# Generate using: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# Full URL to access GTMS on your local network or reverse proxy
APP_URL=http://<SYNOLOGY_NAS_IP>:8000

# Synology DSM User Identity (PUID/PGID for Container Manager)
# Default admin user is typically UID 1026, administrators group GID 100
PUID=1026
PGID=100

# MySQL 8.0 Database Configuration
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=gtms_data
DOCKER_DB_USER=gtms_user
DOCKER_DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
DOCKER_DB_ROOT_PASSWORD=YOUR_STRONG_ROOT_PASSWORD_HERE

# Redis 7 Cache & Queue Configuration
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# Chunked Upload Temporary Staging Path
CHUNKS_STORAGE_PATH=/var/www/html/storage/app/chunks
